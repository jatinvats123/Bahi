# Bahi environment. Copy to .env.local and fill in. Never commit .env.local.
# Empty values are treated as "not set".

# --- Models (phase 3) ---
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=
# Verify the current id in Google AI docs when implementing phase 3.
GEMINI_MODEL=
GROQ_API_KEY=
# Verify the current id in Groq docs when implementing phase 3.
GROQ_MODEL=

# --- Swytchcode (phase 2) ---
# mock = fixtures only, no accounts needed. live = real sandbox calls through Swytchcode.
SWYTCH_MODE=mock
# Swytchcode credentials are added in phase 2 after reading docs.swytchcode.com.

# --- Guardrails (phase 4) ---
APPROVAL_THRESHOLD_INR=50000
REFUND_BLOCK_THRESHOLD_INR=10000

# --- Laya System-1 layer (phase 6, optional) ---
LAYA_ENABLED=false
LAYA_URL=http://127.0.0.1:8000

# --- Notion ---
NOTION_PARENT_PAGE_ID=
NOTION_LEDGER_DATABASE_ID=

# --- Jira ---
JIRA_PROJECT_KEY=BAHI

# --- Slack (channel names without #) ---
SLACK_OPS_CHANNEL=bahi-ops
SLACK_APPROVALS_CHANNEL=approvals

# --- Business ---
BUSINESS_NAME=DukaanSetu
BUSINESS_EMAIL=
PAYPAL_CURRENCY=INR
