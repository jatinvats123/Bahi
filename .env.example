# Bahi environment. Copy to .env.local and fill in. Never commit .env.local.
# Empty values are treated as "not set".

# --- Models (phase 3) ---
# Agent brain: Vercel AI SDK 7. Order per LLM call: each GEMINI_MODEL with GEMINI_API_KEY,
# the same model with GEMINI_API_KEY_BACKUP (optional, a key from a second Google project),
# then each GROQ_MODEL. Rate limits, 5xx, timeouts and bad keys fall through; the timeline says so.
# Keys: https://aistudio.google.com/apikey and https://console.groq.com/keys
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=
# Comma-separated, tried in order. Verified 25 Sep 2026 (tool calling, live model list).
# Free tier is 20 requests/day per model per project, so keep more than one.
# Blank = gemini-3.6-flash,gemini-3-flash-preview,gemini-3.5-flash-lite
GEMINI_MODEL=
GROQ_API_KEY=
# Comma-separated. Free tier is about 8k tokens/minute per model. Blank = openai/gpt-oss-120b,qwen/qwen3.8-27b
GROQ_MODEL=

# --- Agent mode (phase 5) ---
# live = the agent really runs. replay = POST /api/runs plays a recorded live run from fixtures/runs/
# (demo safety net and e2e backbone). Replays are always labelled "Recorded run" in the UI.
AGENT_MODE=live
# Replay speed: 1 = recorded pace with long waits trimmed.
REPLAY_SPEED=1

# --- Swytchcode (phase 2) ---
# mock = fixtures only, no accounts needed. live = real sandbox calls through Swytchcode.
SWYTCH_MODE=mock
# No Swytchcode secrets live here: `swy login` keeps the session in ~/.swytchcode/auth.json and
# `swy auth connect <provider>` keeps provider credentials in ~/.swytchcode/credentials.db.
# cli = async spawn of the native swytchcode binary (default); sdk = @swytchcode/runtime in a worker thread.
SWYTCH_TRANSPORT=cli
# Optional: absolute path to swytchcode.exe if auto-detection fails.
SWYTCHCODE_BIN=
# Optional: folder that holds .swytchcode/ (defaults to the repo root).
SWYTCHCODE_PROJECT_DIR=
SWYTCH_TIMEOUT_MS=45000
# Bahi turns CLI telemetry off (its upload cost 1.4-30 s per call). Set 0 to keep it on.
SWYTCHCODE_NO_TELEMETRY=

# --- Guardrails (phase 4) ---
APPROVAL_THRESHOLD_INR=50000
REFUND_BLOCK_THRESHOLD_INR=10000
# Seconds a large invoice waits for the owner's approval before it expires.
APPROVAL_TIMEOUT_SEC=300
# gate = Swytchcode blocks large invoices until Bahi's approval desk stamps them (works on every plan).
# swytchcode = Swytchcode REQUIRES_APPROVAL with Slack approval (needs a plan with approval workflows).
# After changing thresholds, the currency rate or clients, run: npm run policies:sync
APPROVAL_MODE=gate

# --- Notion ---
NOTION_PARENT_PAGE_ID=
NOTION_LEDGER_DATABASE_ID=
# Printed by npm run setup:notion (resolved from the database when blank).
NOTION_LEDGER_DATA_SOURCE_ID=

# --- Jira ---
# Your Jira Cloud site; npm run swytch:configure writes it into the Swytchcode manifest.
JIRA_BASE_URL=
JIRA_PROJECT_KEY=BAHI

# --- Slack (channel names without #) ---
SLACK_OPS_CHANNEL=bahi-ops
SLACK_APPROVALS_CHANNEL=approvals
# Complaints, suspicious mail, blocked actions. Blank = same as SLACK_OPS_CHANNEL.
SLACK_ALERTS_CHANNEL=

# --- Business ---
BUSINESS_NAME=DukaanSetu
# Where the owner opens Bahi (Slack approval messages link here).
BAHI_PUBLIC_URL=http://localhost:3000
# The Gmail inbox Bahi reads (also the seed-script recipient).
BUSINESS_EMAIL=
# PayPal sandbox app (developer.paypal.com > Sandbox > Apps & Credentials). Only used by npm run paypal:token,
# which turns them into PAYPAL_API_KEY (a sandbox access token, about 9 h) that Swytchcode reads from the env.
# Needed on the free Swytchcode plan, where connecting your own PayPal credentials in the browser is paid.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_KEY=
# PayPal sandbox business (merchant) account email.
PAYPAL_MERCHANT_EMAIL=
# INR or USD. If the sandbox rejects INR invoices use USD; amounts convert at DEMO_INR_PER_USD.
PAYPAL_CURRENCY=INR
DEMO_INR_PER_USD=83
