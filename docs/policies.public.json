{
  "defaults": {
    "on_violation": "fail",
    "evaluation": "pre_execution"
  },
  "policies": [
    {
      "id": "invoice-approval-over-threshold",
      "name": "Large invoices need owner approval",
      "target": [
        "invoices.invoicing.invoices.create"
      ],
      "when": {
        "operator": "all",
        "conditions": [
          {
            "field": "body",
            "operator": "matches",
            "value": "unit_amount:map\\[currency_code:(?:INR value:(?:0*(?:[1-9]\\d{5,}|[6-9]\\d{4}|5[1-9]\\d{3}|50[1-9]\\d{2}|500[1-9]\\d{1}|5000[1-9])(?:\\.\\d*)?|0*50000\\.0*[1-9]\\d*)|USD value:(?:0*(?:[1-9]\\d{3,}|[7-9]\\d{2}|6[1-9]\\d{1}|60[3-9])(?:\\.\\d*)?|0*602\\.(?:[5-9]\\d*|4[2-9]\\d*|410*[1-9]\\d*)))\\]"
          },
          {
            "operator": "not",
            "conditions": [
              {
                "field": "body",
                "operator": "matches",
                "value": "memo:Bahi approval apr_[0-9a-z]{8,}"
              }
            ]
          }
        ]
      },
      "action": {
        "type": "POLICY_BLOCKED",
        "message": "Invoice above Rs 50,000 needs the owner's approval before it reaches PayPal."
      }
    },
    {
      "id": "block-large-refunds",
      "name": "No large or full refunds by the agent",
      "target": [
        "payments.payment.captures.refund"
      ],
      "when": {
        "operator": "any",
        "conditions": [
          {
            "field": "body",
            "operator": "not_exists"
          },
          {
            "field": "body",
            "operator": "not_contains",
            "value": "amount:map["
          },
          {
            "field": "body",
            "operator": "matches",
            "value": "amount:map\\[currency_code:(?:INR value:(?:0*(?:[1-9]\\d{5,}|[2-9]\\d{4}|1[1-9]\\d{3}|10[1-9]\\d{2}|100[1-9]\\d{1}|1000[1-9])(?:\\.\\d*)?|0*10000\\.0*[1-9]\\d*)|USD value:(?:0*(?:[1-9]\\d{3,}|[2-9]\\d{2}|1[3-9]\\d{1}|12[1-9])(?:\\.\\d*)?|0*120\\.(?:[5-9]\\d*|49\\d*|480*[1-9]\\d*)))\\]"
          }
        ]
      },
      "action": {
        "type": "POLICY_BLOCKED",
        "message": "Refund above Rs 10,000 blocked by Bahi policy. Owner must do this manually."
      }
    },
    {
      "id": "email-known-clients-only",
      "name": "Email only known clients",
      "target": [
        "gmail.user.send.create1"
      ],
      "when": {
        "operator": "not",
        "conditions": [
          {
            "field": "body",
            "operator": "matches",
            "value": "^map\\[raw:(?:VG86IGFjY291bnRzQHNoYXJtYXRyYWRlcnMuZXhhbXBsZQ0K|VG86IGJpbGxpbmdAZ3VwdGFlbGVjdHJvbmljcy5leGFtcGxlIA0K|VG86IGV2ZW50c0BpeWVyY2F0ZXJlcnMuZXhhbXBsZQ0K|VG86IGhlbGxvQGtoYW5uYXRhaWxvcnMuZXhhbXBsZQ0K|VG86IG9yZGVyc0B2ZXJtYXN3ZWV0cy5leGFtcGxlIA0K)"
          }
        ]
      },
      "action": {
        "type": "POLICY_BLOCKED",
        "message": "Recipient is not a known client. Bahi only emails clients in its client list."
      }
    }
  ]
}
